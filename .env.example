# Copy to .env for local development. Never commit .env.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
# Leave empty locally to use SQLite. On Vercel use your Neon connection string (pooled).
DATABASE_URL=

# --- AI (both free; at least one is required) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast
# Which provider to try first: gemini or grok (the other is the automatic fallback)
AI_PRIMARY=gemini
AI_DAILY_LIMIT=60

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
